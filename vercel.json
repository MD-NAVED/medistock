{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "server/**" }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "outputDirectory": "dist"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "client/assets/$1"
    },
    { "src": "/manifest.webmanifest", "headers": { "content-type": "application/manifest+json" }, "dest": "client/manifest.webmanifest" },
    { "src": "/sw.js", "headers": { "cache-control": "public, max-age=0, must-revalidate", "service-worker-allowed": "/" }, "dest": "client/sw.js" },
    { "src": "/icon-(.*)", "headers": { "cache-control": "public, max-age=86400" }, "dest": "client/icon-$1" },
    { "src": "/(.*)", "dest": "client/index.html" }
  ]
}
