# Copy this file to ".env" (same folder) and fill in your real values.
# Local runs (npm start) read it automatically; Vercel uses its own
# Environment Variables settings, not this file.

# Supabase -> Connect -> Connection string -> Transaction pooler (port 6543),
# with [YOUR-PASSWORD] replaced by your database password.
DATABASE_URL=postgres://postgres.YOURREF:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Keeps each local/serverless pool small (3 connections is plenty locally too).
DATABASE_POOL_MAX=3
