{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/pdfkit/**", "node_modules/fontkit/**", "node_modules/linebreak/**"]
      }
    }
  ],
  "functions": {
    "index.js": {
      "includeFiles": "node_modules/pdfkit/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}